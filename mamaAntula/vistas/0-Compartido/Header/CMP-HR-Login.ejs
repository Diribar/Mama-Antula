<!-- Ícono -->
<i id="iconoUsuario" class="fa-regular <%= iconos.login %> mostrarClick" title="Login/Registrarse"></i>

<!-- Form login -->
<form id="menuLogin" class="mostrarToggle menuForm ocultar">
	<!-- Inputs -->
	<input type="email" name="email" placeholder="e-mail">
	<div id="contContrasena" class="relative">
		<input type="password" name="contrasena" placeholder="contraseña">
		<i id="eye" class="<%= iconos.faSolid %> fa-eye-slash absolute"></i>
	</div>
	<p id="mensajeError"></p>


	<!--Iconos-->
	<button id="confirmaLogin" class="scaleHover" type="button">Login</button>
	<div id="videos" class="flexRowAlign">
		<a href="/videos" class="flexRowAlign scaleHover">
			<i class="fa-solid fa-circle-question" title="Ayuda"></i>
		</a>
		<a href="/usuarios<%= rutasUsuario.altaOlvido %>">
			<i id="altaOlvido" class="<%= iconos.faSolid %> fa-key scaleHover" title="Registrarte / Olvido de contraseña"></i>
		</a>
	</div>
</form>

